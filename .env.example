# Public backend settings used by both the browser and server.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only. Configure this in Vercel; never prefix it with VITE_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI Service (Provide at least one of these for image predictions)
# - GEMINI_API_KEY from https://aistudio.google.com/app/apikey (Recommended)
# - OPENAI_API_KEY from https://platform.openai.com/api-keys
# - LOVABLE_API_KEY from Lovable Cloud
GEMINI_API_KEY=your-gemini-api-key
# OPENAI_API_KEY=your-openai-api-key
# LOVABLE_API_KEY=your-lovable-api-key
