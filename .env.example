# Public backend settings used by both the browser and server.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only. Configure this in Vercel; never prefix it with VITE_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI Service. LOVABLE_API_KEY is used by default (injected automatically on
# Lovable hosting; copy it into Vercel env vars for external deploys).
LOVABLE_API_KEY=your-lovable-api-key
# Optional fallbacks if you'd rather use your own provider keys:
# GEMINI_API_KEY=your-gemini-api-key
# OPENAI_API_KEY=your-openai-api-key
